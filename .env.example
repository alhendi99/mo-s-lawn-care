# Estimate email delivery (server-only; existing Resend workflow)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_TO_EMAIL=

# The GA4 Measurement ID is public client configuration; activation is fail-closed.
# Supply only the verified production web-stream G-... ID. Never use a placeholder.
GA4_MEASUREMENT_ID=

# Set both values to true only after the production stream ownership/injection
# audit, consent decision, and Enhanced Measurement review are documented.
# The tag still loads only when VERCEL_ENV=production.
GA4_ENABLED=false
GA4_ACTIVATION_APPROVED=false
